__pycache__/
*.py[cod]
*.egg-info/
dist/
.venv/
venv/
.venv-cdk/
node_modules/
.next/
out/
cdk.out/
.env
cdk/config/settings.py
*.js.map
.omc/
agent/_deps/

# Claude Code — keep project-shared configs (settings.json, agents/,
# commands/, skills/) versioned so collaborators get the same workflow,
# but ignore per-user runtime state.
.claude/*.lock
.claude/*.local.json
.claude/projects/
.claude/state/
.pytest_cache/

# Customer-facing demo/presentation materials — local only, not part of the
# product source. Intro deck (HTML), simulation guide, incident trigger/resolve
# scripts. Kept out of the repo intentionally.
/demo/

# Subagent-driven-development scratch (briefs, reports, ledger) — local only
.superpowers/

# One-off audit scratch files belong in the notes vault, not the repo.
.audit-*

# CDK writes resolved context lookups here, keyed by AWS ACCOUNT ID, so a
# tracked copy publishes the operator's account. The one entry CI needs (the
# settings.example.py account's AZ list) lives in cdk/cdk.json's `context`
# block instead, which the CLI treats as read-only and never rewrites.
# Measured: credential-free `cdk synth --no-lookups` exits 0 with this file
# absent, and the CLI does not recreate it.
# If a NEW context lookup is ever added (from_lookup, SSM, VPC), CI will fail
# with a missing-context error: add that entry to cdk/cdk.json by hand.
cdk/cdk.context.json

# Local deploy artifacts (from `cdk deploy` / a locally-installed cdk CLI).
# cdk-outputs.json embeds the operator's account-specific ARNs and URLs; the
# deploy logs and the root package*.json (created by `npm install aws-cdk`
# locally) are throwaway. deploy.sh regenerates what it needs.
cdk-outputs.json
deploy*.log
/package.json
/package-lock.json
